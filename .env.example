# Werbe-Tracking (Google Ads über Google Tag Manager) – standardmäßig AUS.
# NEXT_PUBLIC_* wird beim Build eingesetzt: Nach einer Änderung neu bauen/deployen.
# Geladen wird der Tag Manager nur, wenn TRACKING_ENABLED "true" ist UND eine gültige GTM-ID gesetzt ist.
NEXT_PUBLIC_TRACKING_ENABLED=false
NEXT_PUBLIC_GTM_ID=
