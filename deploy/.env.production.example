# Vorlage – auf dem Server nach /opt/tonn-versicherung/.env.production kopieren, Werte eintragen,
# danach: chmod 600 /opt/tonn-versicherung/.env.production
# Echte Werte NIEMALS ins Repository, in Logs oder Tickets schreiben.

# E-Mail-Versand Kontaktformular (Resend)
RESEND_API_KEY=
CONTACT_MAIL_FROM=

# Google Places (Bewertungen auf der Startseite, Aktualisierung alle 24 h per ISR)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
